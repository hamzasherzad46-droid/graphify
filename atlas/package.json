{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:text && tsc -b && vite build",
    "preview": "vite preview",
    "build:preview": "npm run check:text && tsc -b && vite build --mode artifact && node scripts/preview-assets.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "content": "python3 scripts/bones_src.py",
    "model": "node scripts/build-skeleton.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "check:text": "node scripts/textcheck.mjs",
    "check:grammar": "node scripts/textcheck.mjs --grammar",
    "dictionary": "node scripts/build-dictionary.mjs",
    "structures:review": "node scripts/structures-review.mjs",
    "review:pack": "node scripts/textcheck.mjs --json && node scripts/review-pack.mjs",
    "review:checklist": "node scripts/dagger-checklist.mjs",
    "review:checklist:pdf": "node scripts/checklist-pdf.cjs docs/dagger-checklist.md docs/dagger-checklist.pdf"
  },
  "dependencies": {
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.8.3",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "dictionary-en-gb": "^3.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "nspell": "^2.1.5",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "varcon": "^1.0.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
