{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:preview": "tsc -b && vite build --mode artifact && node scripts/preview-assets.mjs",
    "lint": "eslint .",
    "test": "vitest run",
